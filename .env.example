# ---------------------------------------------------------------
# Norte — variáveis de ambiente (NÃO commite valores reais)
# ---------------------------------------------------------------
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:5432/painel

# Segredo das sessões do Better Auth (>= 32 caracteres). Gere: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Chave AES-256-GCM para tokens da Meta em repouso (32 bytes base64).
# Gere: openssl rand -base64 32   — guarde em um cofre (KMS/Secrets Manager) em produção.
TOKEN_ENCRYPTION_KEY=

# --- Meta (Facebook Login for Business + Marketing API) ---
# Deixe vazio para usar apenas o Modo demonstração.
META_APP_ID=
META_APP_SECRET=
# ID da configuração criada em Facebook Login for Business > Configurações
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# --- Sincronização ---
SYNC_INTERVAL_MINUTES=15
SYNC_INITIAL_HISTORY_DAYS=90
SYNC_RECONCILIATION_DAYS=7
MANUAL_REFRESH_COOLDOWN_SECONDS=120

# --- E-mail (recuperação de senha e convites) ---
# Sem SMTP_URL, os e-mails ficam na tabela mail_outbox e no log do servidor (apenas desenvolvimento).
SMTP_URL=
MAIL_FROM="Norte <nao-responda@seu-dominio.com>"
